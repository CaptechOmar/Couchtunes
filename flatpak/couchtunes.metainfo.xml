<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>@APP_ID@</id>
  <name>Couchtunes</name>
  <summary>An Apple Music-style player for your Navidrome server</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <developer_name>Omar Ashraf</developer_name>
  <url type="homepage">https://github.com/@OWNER@/Couchtunes</url>
  <url type="bugtracker">https://github.com/@OWNER@/Couchtunes/issues</url>
  <description>
    <p>Couchtunes plays the music on your own Navidrome (Subsonic / OpenSubsonic) server in a clean, big-screen layout. It is built to be driven with arrow keys, a TV remote or a game controller, and it works with a mouse and keyboard too.</p>
    <p>Features include synced lyrics, an Up next queue, search with an on-screen keyboard, album, artist and playlist pages, light and dark themes, and keyboard and controller shortcuts.</p>
    <p>Couchtunes is an independent project. It is not affiliated with Apple or Navidrome.</p>
  </description>
  <launchable type="desktop-id">@APP_ID@.desktop</launchable>
  <categories>
    <category>AudioVideo</category>
    <category>Audio</category>
    <category>Music</category>
    <category>Player</category>
  </categories>
  <content_rating type="oars-1.1"/>
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
    <control>gamepad</control>
  </supports>
  <screenshots>
    <screenshot type="default">
      <caption>Listen now: your recent, new and favorite albums</caption>
      <image type="source">https://raw.githubusercontent.com/@OWNER@/Couchtunes/main/docs/screenshots/listen-now.png</image>
    </screenshot>
    <screenshot>
      <caption>Browse your whole library</caption>
      <image type="source">https://raw.githubusercontent.com/@OWNER@/Couchtunes/main/docs/screenshots/library-albums.png</image>
    </screenshot>
    <screenshot>
      <caption>An album with its tracks</caption>
      <image type="source">https://raw.githubusercontent.com/@OWNER@/Couchtunes/main/docs/screenshots/album-view.png</image>
    </screenshot>
    <screenshot>
      <caption>Synced lyrics</caption>
      <image type="source">https://raw.githubusercontent.com/@OWNER@/Couchtunes/main/docs/screenshots/lyrics.png</image>
    </screenshot>
  </screenshots>
